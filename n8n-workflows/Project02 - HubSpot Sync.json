        "query": "\nINSERT INTO hubspot_sync_jobs (\n    customer_id,\n    status\n)\nSELECT\n    c.id,\n    'pending'\nFROM customers c\nWHERE c.primary_email IS NOT NULL\n  AND TRIM(c.primary_email) <> ''\n  AND c.hubspot_contact_id IS NULL\n\nON CONFLICT (customer_id)\nDO NOTHING\n\nRETURNING\n    id,\n    customer_id,\n    status;\n",
