      ],
      "id": "ac6fddc3-c415-4235-bc4e-9f27fd4afcb1",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\nconst execution = input.execution ?? {};\nconst workflow = input.workflow ?? {};\nconst trigger = input.trigger ?? {};\n\nreturn [{\n  json: {\n    workflow_id: String(workflow.id ?? \"\"),\n    workflow_name: String(workflow.name ?? \"unknown\"),\n    execution_id: String(execution.id ?? \"\"),\n    failed_node: String(\n      execution.lastNodeExecuted ?? \"unknown\"\n    ),\n    error_message: String(\n      execution.error?.message ??\n      trigger.error?.message ??\n      \"Unknown workflow error\"\n    ),\n    occurred_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -16
      ],
      "id": "0032ad09-0807-47a6-9658-a2339c0eb728",
      "name": "NormalizeWorkflowError"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nINSERT INTO workflow_error_logs (\n    workflow_id,\n    workflow_name,\n    execution_id,\n    failed_node,\n    error_message\n)\nVALUES ($1, $2, $3, $4, $5)\nON CONFLICT DO NOTHING\nRETURNING id;\n",
        "options": {
          "queryReplacement": "=\n{{ [\n  $json.workflow_id,\n  $json.workflow_name,\n  $json.execution_id,\n  $json.failed_node,\n  $json.error_message\n] }}\n"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
