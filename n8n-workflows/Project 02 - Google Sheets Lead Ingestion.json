    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item, index) => {\n  const row = item.json;\n\n  const rawBudget = row.budget;\n  const budget =\n    rawBudget === \"\" || rawBudget == null\n      ? null\n      : Number(rawBudget);\n\n  const sourceId = String(\n    row.lead_id ?? \"\"\n  ).trim();\n\n  return {\n    json: {\n      source: \"google_sheets\",\n      source_event_id: sourceId,\n\n      customer: {\n        name: String(\n          row.full_name ?? \"\"\n        ).trim().replace(/\\s+/g, \" \"),\n\n        email: String(\n          row.email ?? \"\"\n        ).trim().toLowerCase(),\n\n        phone: String(\n          row.phone ?? \"\"\n        ).trim(),\n\n        company: String(\n          row.company ?? \"\"\n        ).trim()\n      },\n\n      inquiry: {\n        service: String(\n          row.service ?? \"\"\n        ).trim(),\n\n        budget,\n\n        message: String(\n          row.message ?? \"\"\n        ).trim()\n      },\n\n      metadata: {\n        sheet_lead_id: sourceId,\n        sheet_status: String(row.status ?? \"\")\n      }\n    },\n    pairedItem: {\n      item: index\n    }\n  };\n});\n"
      },
