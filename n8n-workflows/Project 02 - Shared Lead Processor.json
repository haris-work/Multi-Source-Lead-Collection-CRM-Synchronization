    {
      "parameters": {
        "jsCode": "\nconst existing = $input.first().json;\n\nconst lead = $(\"ValidateAndPrepareEvent\")\n  .first().json;\n\nconst alreadyExists =\n  existing.event_key === lead.event_key;\n\nreturn [{\n  json: {\n    ...lead,\n    already_exists: alreadyExists,\n\n    previous_status: alreadyExists\n      ? existing.status\n      : null\n  }\n}];\n"
      },
