      "id": "991ccc44-7370-483c-98a4-72e55d1a0a34",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst allowedSources = [\n  \"website\",\n  \"marketing\",\n  \"external_crm\",\n  \"google_sheets\",\n  \"gmail\"\n];\n\nreturn items.map((item, index) => {\n  const lead = item.json;\n  const errors = [];\n\n  const source = String(lead.source ?? \"\").trim();\n  const sourceEventId = String(\n    lead.source_event_id ?? \"\"\n  ).trim();\n\n  const name = String(\n    lead.customer?.name ?? \"\"\n  ).trim().replace(/\\s+/g, \" \");\n\n  const email = String(\n    lead.customer?.email ?? \"\"\n  ).trim().toLowerCase();\n\n  const service = String(\n    lead.inquiry?.service ?? \"\"\n  ).trim();\n\n  const rawBudget = lead.inquiry?.budget;\n\n  const budget =\n    rawBudget === null ||\n    rawBudget === undefined ||\n    rawBudget === \"\"\n      ? null\n      : Number(rawBudget);\n\n  if (!allowedSources.includes(source)) {\n    errors.push(\"Unsupported source\");\n  }\n\n  if (!/^[A-Za-z0-9_-]{3,100}$/.test(sourceEventId)) {\n    errors.push(\"Invalid source event ID\");\n  }\n\n  if (name.length < 2) {\n    errors.push(\"Invalid customer name\");\n  }\n\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n    errors.push(\"Invalid email address\");\n  }\n\n  if (!service) {\n    errors.push(\"Service is required\");\n  }\n\n  if (\n    budget !== null &&\n    (!Number.isFinite(budget) || budget < 0)\n  ) {\n    errors.push(\"Invalid estimated budget\");\n  }\n\n  return {\n    json: {\n      ...lead,\n      source,\n      source_event_id: sourceEventId,\n      event_key: `${source}:${sourceEventId}`,\n\n      customer: {\n        ...lead.customer,\n        name,\n        email\n      },\n\n      inquiry: {\n        ...lead.inquiry,\n        service,\n        budget\n      },\n\n      validation: {\n        is_valid: errors.length === 0,\n        errors\n      }\n    },\n    pairedItem: { item: index }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "991484c8-92e3-4342-b99c-37003b25cb4c",
