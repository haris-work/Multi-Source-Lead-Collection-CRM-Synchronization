      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const lead = item.json;\n\n  return {\n    json: {\n      result: \"rejected\",\n      http_status: 400,\n      event_key: null,\n      source: lead.source,\n      errors: lead.validation.errors\n    }\n  };\n});\n"
      },
