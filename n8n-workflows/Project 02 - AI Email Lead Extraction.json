    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => ({\n  json: {\n    result: \"manual_review\",\n    reason: \"Missing message ID, sender email, or body\",\n    gmail_message_id: item.json.gmail_message_id\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
